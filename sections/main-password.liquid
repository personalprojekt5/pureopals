{%- comment -%}
  Landing page = Shopify's password page. Shown to everyone while Online Store → Preferences → Password
  protection is on. Email sign-ups go to Customers (tagged "newsletter", with email marketing consent).
  Turn password protection off to open the store: this page then disappears by itself.
{%- endcomment -%}
{%- liquid
  assign pass_error = false
  assign open = 'list'
-%}
{%- capture pass_form -%}
  {%- form 'storefront_password', class: 'pw__form' -%}
    {%- if form.errors -%}{%- assign pass_error = true -%}{%- endif -%}
    <label class="pw__label cap" for="pw">Password</label>
    <div class="pw__row">
      <input class="pw__input pw__input--pass" id="pw" name="password" type="password" autocomplete="current-password" autocapitalize="off" spellcheck="false" required placeholder="Password">
      <button class="pw__go" type="submit" aria-label="Enter"><svg width="22" height="12" viewBox="0 0 26 14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M1 7h24M19 1l6 6-6 6"/></svg></button>
    </div>
    <p class="pw__msg cap" role="alert">{% if form.errors %}{{ section.settings.wrong_password | escape }}{% endif %}</p>
    <button class="pw__back cap" type="button" data-to-list>Back to the list</button>
  {%- endform -%}
{%- endcapture -%}
{%- if pass_error -%}{%- assign open = 'password' -%}{%- endif -%}

{% render 'status-bar', show_status: section.settings.show_status, signal: 'No service', right: 'password' %}
<div class="pw{% if section.settings.bg != blank %} has-bg{% endif %}" data-landing data-open="{{ open }}">
  {%- if section.settings.bg != blank -%}
    <div class="pw__bg" style="--bg-pos: {{ section.settings.bg.presentation.focal_point | default: '50% 50%' }}; --bg-veil: {{ section.settings.bg_veil | divided_by: 100.0 }}">
      {%- assign bg_alt = section.settings.bg.alt | default: '' -%}
      {{ section.settings.bg | image_url: width: 2400 | image_tag: alt: bg_alt, widths: '750, 1100, 1500, 1800, 2400', sizes: '100vw', loading: 'eager', fetchpriority: 'high' }}
    </div>
  {%- endif -%}
  <div class="pw__box">
    {%- if section.settings.image != blank -%}
      {%- assign im_alt = section.settings.image.alt | default: shop.name -%}
      {%- assign im_w2 = section.settings.image_width | times: 2 -%}
      <div class="pw__image" style="--img-w: {{ section.settings.image_width }}px">
        {{ section.settings.image | image_url: width: im_w2 | image_tag: alt: im_alt, loading: 'eager', fetchpriority: 'high', widths: '200, 400, 600, 800, 1200' }}
      </div>
    {%- endif -%}
    {%- if section.settings.kicker != blank -%}<p class="cap">{{ section.settings.kicker | escape }}</p>{%- endif -%}
    {%- if section.settings.title != blank -%}<h1 class="pw__title">{{ section.settings.title }}</h1>{%- else -%}<h1 class="visually-hidden">{{ shop.name }}</h1>{%- endif -%}
    <p class="pw__sub">{{ shop.password_message | default: section.settings.sub | strip_html | escape }}</p>

    {%- if section.settings.drop_date != blank -%}
      <ol class="pw__count" data-countdown data-drop="{{ section.settings.drop_date | escape }}" aria-label="Time until the drop" hidden>
        <li><b>00</b><span class="cap">Days</span></li>
        <li><b>00</b><span class="cap">Hrs</span></li>
        <li><b>00</b><span class="cap">Min</span></li>
        <li><b>00</b><span class="cap">Sec</span></li>
      </ol>
    {%- endif -%}

    <div data-signup class="pw__panel"{% if open == 'password' %} hidden{% endif %}>
      {%- form 'customer', class: 'pw__form' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <input type="hidden" name="contact[accepts_marketing]" value="true">
        {%- if form.posted_successfully? -%}
          <div class="pw__row is-done"><span class="pw__input">{{ section.settings.done | escape }}</span></div>
          <p class="pw__msg cap" role="status">{{ section.settings.done_line | escape }}</p>
        {%- else -%}
          <label class="pw__label cap" for="email">Email</label>
          <div class="pw__row">
            <input class="pw__input" id="email" name="contact[email]" type="email" autocomplete="email" inputmode="email" required placeholder="Your email" value="{{ form.email }}">
            <button class="pw__go pw__go--text" type="submit"><span class="cap">{{ section.settings.button | escape }}</span><svg width="22" height="12" viewBox="0 0 26 14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M1 7h24M19 1l6 6-6 6"/></svg></button>
          </div>
          <p class="pw__msg cap" role="status">{%- if form.errors -%}{{ form.errors.translated_fields.email | default: 'Email' }} {{ form.errors.messages.email | default: "doesn't look right." }}{%- endif -%}</p>
        {%- endif -%}
        <p class="pw__note cap">{{ section.settings.note | escape }}</p>
      {%- endform -%}
    </div>
    <div data-pass class="pw__panel"{% if open != 'password' %} hidden{% endif %}>{{ pass_form }}</div>
  </div>
  {%- if section.settings.show_line -%}
  <div class="pw__line" aria-hidden="true" style="--n: {{ section.blocks.size | at_least: 1 }}">
    {%- for block in section.blocks -%}
      {%- liquid
        if block.settings.model != blank
          assign img = block.settings.model | image_url: width: 571
        else
          assign img = block.settings.model_url
        endif
        if block.settings.shadow != blank
          assign sh = block.settings.shadow | image_url: width: 685
        else
          assign sh = block.settings.shadow_url
        endif
        assign foot = block.settings.foot | divided_by: 1000.0
      -%}
      <div class="pw__fig" style="--foot: {{ foot }}; --i: {{ forloop.index0 }}" {{ block.shopify_attributes }}>
        {%- if sh != blank -%}<img class="pw__cast" src="{{ sh }}" alt="" width="685" height="800" decoding="async">{%- endif -%}
        {%- if img != blank -%}<img class="pw__pic" src="{{ img }}" alt="" width="571" height="1000" decoding="async">{%- endif -%}
      </div>
    {%- endfor -%}
  </div>
  {%- endif -%}
</div>
<script src="{{ 'offline-password.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Landing page",
  "tag": "section",
  "max_blocks": 12,
  "settings": [
    { "type": "paragraph", "content": "This is your password page. It shows while Online Store → Preferences → Password protection is on. The text under the title is the password page message from Preferences (or the text below if that is empty)." },
    { "type": "text", "id": "kicker", "label": "Small line", "default": "Drop 01 · Coming soon" },
    { "type": "inline_richtext", "id": "title", "label": "Title", "default": "Go touch some <em>grass.</em>" },
    { "type": "textarea", "id": "sub", "label": "Text", "default": "Nine looks for logging off. Leave your email and we'll tell you the moment the store comes back online. That's the only email you'll get." },
    { "type": "text", "id": "drop_date", "label": "Drop date for the countdown", "info": "e.g. 2026-12-12T18:00:00+01:00. Leave empty for no countdown." },
    { "type": "header", "content": "Image" },
    { "type": "image_picker", "id": "image", "label": "Image above the title", "info": "Your logo, a wordmark or a product shot. Shown centred, at the width below." },
    { "type": "range", "id": "image_width", "label": "Image width", "min": 80, "max": 800, "step": 10, "unit": "px", "default": 320 },
    { "type": "paragraph", "content": "Leave Title or Small line empty to hide them." },
    { "type": "header", "content": "Background" },
    { "type": "image_picker", "id": "bg", "label": "Background photo", "info": "Fills the page behind the text. Set the focal point on the image so the important part stays in view." },
    { "type": "range", "id": "bg_veil", "label": "Studio veil over the photo", "min": 0, "max": 90, "step": 5, "unit": "%", "default": 35, "info": "Lightens the photo so the text stays readable." },
    { "type": "checkbox", "id": "show_line", "label": "Show the line of models", "default": true, "info": "Each model is a block below. Add, remove or reorder them; the line resizes to fit." },
    { "type": "header", "content": "Sign-up" },
    { "type": "text", "id": "button", "label": "Button", "default": "Join" },
    { "type": "text", "id": "note", "label": "Small print", "default": "One email per drop · Unsubscribe anytime" },
    { "type": "text", "id": "done", "label": "After signing up", "default": "You're on the list" },
    { "type": "text", "id": "done_line", "label": "Line under it", "default": "Now go outside." },
    { "type": "text", "id": "wrong_password", "label": "Wrong password message", "default": "Wrong password. Go touch some grass." },
    { "type": "checkbox", "id": "show_status", "label": "Show clock, signal and battery", "default": true }
  ],
  "blocks": [
    { "type": "model", "name": "Model in the line", "settings": [
      { "type": "image_picker", "id": "model", "label": "Model cut-out" },
      { "type": "text", "id": "model_url", "label": "…or image URL" },
      { "type": "image_picker", "id": "shadow", "label": "Floor shadow" },
      { "type": "text", "id": "shadow_url", "label": "…or shadow URL" },
      { "type": "range", "id": "foot", "label": "Empty space under the feet", "min": 0, "max": 100, "step": 1, "unit": "‰", "default": 40 }
    ] }
  ]
}
{% endschema %}
