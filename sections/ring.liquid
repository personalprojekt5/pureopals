  <button class="rw__indexbtn pill" id="indexbtn" type="button" aria-expanded="false" aria-controls="index">Index</button>
  <div class="rw__view" role="group" aria-label="View"><button class="rw__vbtn" type="button" data-v="ring" aria-pressed="true">Ring</button><button class="rw__vbtn" type="button" data-v="grid" aria-pressed="false">Grid</button></div>
  <div class="idx" id="index" aria-hidden="true">
    <div class="idx__top"><span class="cap">{{ section.settings.index_label | escape }}</span><button class="idx__close pill" id="idxclose" type="button">Close</button></div>
    <ol class="idx__list" id="idxlist"></ol>
    {%- if section.settings.menu != blank -%}
      <nav class="idx__nav" aria-label="{{ section.settings.menu.title | escape }}">
        {%- for link in section.settings.menu.links -%}<a class="pill" href="{{ link.url }}">{{ link.title | escape }}</a>{%- endfor -%}
      </nav>
    {%- endif -%}
  </div>
  <div class="rw__lb" id="lb" aria-hidden="true">
    <div class="rw__lb-stage" id="lbstage"></div>
    <div class="rw__lb-top">
      <p class="rw__lb-cap"><span id="lbkick">01.</span><i id="lbname"></i></p>
      <button class="rw__lb-close" id="lbclose" type="button" aria-label="Close look"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><path d="M5 5l14 14M19 5L5 19"/></svg></button>
    </div>
    <p class="rw__lb-hint cap">{{ section.settings.lb_hint | escape }}</p>
  </div>
  <aside class="rw__receipt" id="receipt" aria-label="In this look" aria-hidden="true">
    <div class="rcpt-head">
      {% render 'logo', class: 'rcpt-logo', link: false, size: 'large' %}
      <span class="cap">{{ section.settings.receipt_line | escape }}</span>
      <span class="cap" id="rlook">Look 01 — {{ section.blocks.first.settings.name | escape }}</span>
    </div>
    <ul class="rw__items" id="items" role="list"></ul>
    <div class="rw__bundle">
      <p class="rw__msg" id="msg" role="status" aria-live="polite"></p>
      <dl class="rcpt-sum">
        <div><dt class="cap">Subtotal</dt><dd class="cap" id="rsub">$0</dd></div>
        <div{% if section.settings.discount == 0 %} hidden{% endif %}><dt class="cap">Full look −{{ section.settings.discount }}%</dt><dd class="cap" id="rdisc">$0</dd></div>
        <div class="rcpt-total"><dt>Total</dt><dd id="rtot">$0</dd></div>
      </dl>
      <button class="rw__cta" id="cta" type="button"><span class="t-add">Add full look to bag</span><span class="t-done">Full look in your bag</span><svg width="22" height="12" viewBox="0 0 26 14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M1 7h24M19 1l6 6-6 6"/></svg></button>
    </div>
    <div class="rcpt-foot" aria-hidden="true"><span class="rcpt-bar"></span><span class="cap">{{ section.settings.receipt_thanks | escape }}</span></div>
  </aside>
</section>
<script type="application/json" data-ring-data>
{"discount": {{ section.settings.discount | json }}, "looks": [
{%- for block in section.blocks -%}
  {%- liquid
    if block.settings.model != blank
      assign img = block.settings.model | image_url: width: 914
      assign small = block.settings.model | image_url: width: 571
    else
      assign img = block.settings.model_url
      assign small = block.settings.model_url
    endif
    if block.settings.shadow != blank
      assign shadow = block.settings.shadow | image_url: width: 685
    else
      assign shadow = block.settings.shadow_url
    endif
  -%}
  {"name": {{ block.settings.name | json }}, "foot": {{ block.settings.foot | divided_by: 1000.0 | json }}, "img": {{ img | json }}, "small": {{ small | json }}, "shadow": {{ shadow | json }},
   "pins": [
    {%- assign first = true -%}
    {%- for k in (1..3) -%}
      {%- capture pk %}product_{{ k }}{% endcapture -%}
      {%- capture xk %}pin_{{ k }}_x{% endcapture -%}
      {%- capture yk %}pin_{{ k }}_y{% endcapture -%}
      {%- if block.settings[pk] != blank -%}
        {%- unless first %},{% endunless -%}{%- assign first = false -%}
        [{{ block.settings[xk] | json }}, {{ block.settings[yk] | json }}]
      {%- endif -%}
    {%- endfor -%}],
   "pieces": [
    {%- assign first = true -%}
    {%- for k in (1..3) -%}
      {%- capture pk %}product_{{ k }}{% endcapture -%}
      {%- if block.settings[pk] != blank -%}
        {%- unless first %},{% endunless -%}{%- assign first = false -%}
        {% render 'ring-piece-json', p: block.settings[pk] %}
      {%- endif -%}
    {%- endfor -%}]
  }{% unless forloop.last %},{% endunless %}
{%- endfor -%}
]}
</script>
<script src="{{ 'offline-ring.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{% schema %}
{
  "name": "Ring",
  "tag": "div",
  "class": "ring-wrap",
  "max_blocks": 12,
  "settings": [
    { "type": "inline_richtext", "id": "title", "label": "Page title (for search engines and screen readers)", "default": "Go touch some grass, <em>dude.</em>" },
    { "type": "text", "id": "subtitle", "label": "Description (for search engines and screen readers)", "default": "Drop 01. Nine looks for logging off. Drag the ring, pick a look, tap a dot to shop the piece." },
    { "type": "header", "content": "Receipt" },
    { "type": "text", "id": "receipt_line", "label": "Line under the logo", "default": "Drop 01 · Store 001 · Prague" },
    { "type": "text", "id": "receipt_thanks", "label": "Sign-off under the barcode", "default": "Thank you for logging off" },
    { "type": "range", "id": "discount", "label": "Full look discount shown", "min": 0, "max": 30, "step": 5, "unit": "%", "default": 0, "info": "Only a label: create the matching automatic discount in Shopify admin → Discounts, or leave this at 0 to hide the line." },
    { "type": "header", "content": "Index sheet" },
    { "type": "text", "id": "index_label", "label": "Heading", "default": "Index · Drop 01" },
    { "type": "link_list", "id": "menu", "label": "Menu under the looks", "default": "main-menu" },
    { "type": "header", "content": "Other" },
    { "type": "text", "id": "lb_hint", "label": "View look hint", "default": "Tap a dot to shop the piece" },
    { "type": "checkbox", "id": "show_qr", "label": "Show the filatov.design QR code", "default": true }
  ],
  "blocks": [
    {
      "type": "look",
      "name": "Look",
      "settings": [
        { "type": "text", "id": "name", "label": "Name", "default": "New look" },
        { "type": "image_picker", "id": "model", "label": "Model cut-out", "info": "Transparent PNG or WebP, portrait 4:7 (e.g. 914 × 1600), feet near the bottom edge." },
        { "type": "text", "id": "model_url", "label": "…or model image URL", "info": "Used only when no image is uploaded above." },
        { "type": "image_picker", "id": "shadow", "label": "Floor shadow", "info": "Optional. Transparent, 1.5x as wide as the cut-out, same feet line." },
        { "type": "text", "id": "shadow_url", "label": "…or shadow image URL" },
        { "type": "range", "id": "foot", "label": "Empty space under the feet", "min": 0, "max": 100, "step": 1, "unit": "‰", "default": 40, "info": "Thousandths of the image height below the soles. Raise it if the model floats, lower it if the feet are cut off." },
        { "type": "header", "content": "Piece 01" },
        { "type": "product", "id": "product_1", "label": "Product" },
        { "type": "range", "id": "pin_1_x", "label": "Dot across", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 70 },
        { "type": "range", "id": "pin_1_y", "label": "Dot down", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 34 },
        { "type": "header", "content": "Piece 02" },
        { "type": "product", "id": "product_2", "label": "Product" },
        { "type": "range", "id": "pin_2_x", "label": "Dot across", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 40 },
        { "type": "range", "id": "pin_2_y", "label": "Dot down", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 66 },
        { "type": "header", "content": "Piece 03" },
        { "type": "product", "id": "product_3", "label": "Product" },
        { "type": "range", "id": "pin_3_x", "label": "Dot across", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 40 },
        { "type": "range", "id": "pin_3_y", "label": "Dot down", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 88 }
      ]
    }
  ],
  "presets": [{ "name": "Ring", "blocks": [{ "type": "look" }, { "type": "look" }, { "type": "look" }] }]
}
{% endschema %}
