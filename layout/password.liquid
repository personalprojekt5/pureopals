<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="theme-color" content="{{ settings.color_studio }}">
  {%- if settings.favicon != blank %}
    <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 64, height: 64 }}">
  {%- endif %}
  <title>{{ shop.name }}{% if shop.password_message != blank %} — {{ shop.password_message | strip_html | truncate: 60 }}{% endif %}</title>
  <meta name="description" content="{{ shop.password_message | default: shop.description | strip_html | escape }}">
  {% render 'meta-tags' %}
  <link rel="preconnect" href="https://api.fontshare.com" crossorigin>
  <link href="https://api.fontshare.com/v2/css?f[]=switzer@300,301,400&display=swap" rel="stylesheet">
  {% render 'theme-vars' %}
  {{ 'base.css' | asset_url | stylesheet_tag }}
  {{ 'pages.css' | asset_url | stylesheet_tag }}
  {% render 'routes' %}
  <script src="{{ 'offline-common.js' | asset_url }}" defer="defer"></script>
  {{ content_for_header }}
</head>
<body class="pw-page">
  {{ content_for_layout }}
</body>
</html>
