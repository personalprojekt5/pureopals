{
  "name": "offline-shopify-theme",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "node scripts/build-assets.mjs",
    "typecheck": "tsc -p .",
    "check": "npm run typecheck && npx --yes @shopify/cli@latest theme check --fail-level error",
    "package": "npm run build && node scripts/package.mjs"
  },
  "devDependencies": { "typescript": "5.9.3", "vite": "8.0.13" }
}
