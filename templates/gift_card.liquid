{%- layout none -%}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>Gift card — {{ shop.name }}</title>
  <link href="https://api.fontshare.com/v2/css?f[]=switzer@300,301,400&display=swap" rel="stylesheet">
  {% render 'theme-vars' %}
  {{ 'base.css' | asset_url | stylesheet_tag }}
  {{ 'pages.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'vendor/qrcode.js' | shopify_asset_url }}" defer></script>
</head>
<body class="pg">
  <div class="pw">
    <div class="pw__box gift">
      {% render 'logo', class: 'logo gift__logo', link: false, size: 'large' %}
      <p class="cap">Gift card</p>
      <h1 class="pw__title">{{ gift_card.initial_value | money }}</h1>
      {%- if gift_card.enabled == false or gift_card.expired -%}
        <p class="pw__sub">This gift card is {% if gift_card.expired %}expired{% else %}disabled{% endif %}.</p>
      {%- else -%}
        <p class="pw__sub">Balance {{ gift_card.balance | money }}{% if gift_card.expires_on %} · valid until {{ gift_card.expires_on | date: '%d.%m.%Y' }}{% endif %}</p>
      {%- endif -%}
      <p class="gift__code">{{ gift_card.code | format_code }}</p>
      <div id="QrCode" data-identifier="{{ gift_card.qr_identifier }}"></div>
      <p class="pg__nav"><a class="pill" href="{{ shop.url }}" target="_blank" rel="noopener">Shop now</a><button class="pill" type="button" onclick="window.print()">Print</button></p>
      {%- if gift_card.pass_url -%}<a href="{{ gift_card.pass_url }}"><img src="{{ 'gift-card/add-to-apple-wallet.svg' | shopify_asset_url }}" width="120" height="40" alt="Add to Apple Wallet" loading="lazy"></a>{%- endif -%}
    </div>
  </div>
  <script>
    addEventListener('DOMContentLoaded', function () {
      var el = document.getElementById('QrCode');
      if (window.QRCode && el) new QRCode(el, { text: el.dataset.identifier, width: 120, height: 120, imageAltText: 'Gift card QR code' });
    });
  </script>
</body>
</html>
